#. module: pms_ai_tool_support
#. odoo-python
#: code:addons/pms_ai_tool_support/models/pms_folio_360.py:0
msgid ""
"Payments: posted payments and statement lines linked to the folio by "
"journal and method, net of refunds. Draft and cancelled payments are not "
"counted."
msgstr ""

#. module: pms_ai_tool_support
#. odoo-python
#: code:addons/pms_ai_tool_support/models/pms_folio_360.py:0
