#, python-format
msgid "%(bills)s vendor bills with %(pending)s pending payment on %(cutoff)s."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "Pending bill: posted vendor bill (credit notes are not counted) with an accounting date on or before the cutoff and an amount not yet settled on that date."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "paid_at_cutoff: sum of the reconciliations of the bill whose counterpart entry (payment, bank statement line or credit note) is dated on or before the cutoff, so partial payments count by their own date. pending_at_cutoff: the bill total minus that amount, in the company currency."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "The state of the bill is the current one: a bill posted or a reconciliation undone after the cutoff is not reconstructed. Property: the property of the bill; bills without property are grouped apart."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
#, python-format
msgid "You have no access to the companies %s."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
#, python-format
msgid "INCOMPLETE LIST: more than %(limit)s posted vendor bills may be pending at the cutoff and only the oldest %(limit)s were analysed, so the bills, totals and summaries miss the rest. Narrow it with company_ids, property_ids or supplier."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "last_payment_date: date of the last of those reconciliations, empty when nothing was paid by the cutoff. supplier_id, supplier and supplier_vat: the commercial partner of the bill (the company, not its contact). payable_account: code of the payable account of the bill. journal: code of its journal."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "Filters: company_ids, property_ids, supplier (the bills of its commercial partner) and min_pending (the bills with at least that amount pending at the cutoff). drafts: vendor bills still in draft (pending validation) dated up to the cutoff, by company, with the same filters except min_pending."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
#, python-format
msgid "Bills %(first)s to %(last)s of %(total)s are listed: call again with offset=%(next)s for the next ones, or export the whole list to a file with acc_supplier_bills_pending_export."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
#, python-format
msgid "offset %(offset)s is past the last bill (%(total)s bills)."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
#, python-format
msgid "Only the %(shown)s of %(total)s suppliers with the most pending are listed (max_suppliers, at most %(limit)s)."
msgstr ""

#. module: pms_ai_tool_admin
#. odoo-python
#: code:addons/pms_ai_tool_admin/models/pms_supplier_bills_pending.py:0
msgid "bills: one page of the pending bills, the most pending first; page gives its offset, the total number of bills and next_offset while there are more. totals, by_company, by_property and by_supplier cover every bill that passes the filters. complete: false when the list is cut (see the warnings)."
msgstr ""

