<odoo>
    <record id="pms_room_type_view_form" model="ir.ui.view">
        <field name="name">pms.room.type.connector.dummy.form</field>
        <field name="model">pms.room.type</field>
        <field name="inherit_id" ref="connector_pms.pms_room_type_view_form" />
        <field name="arch" type="xml">
            <!-- Fills the same connector page another connector also fills, so
                 two channel managers rendering side by side is covered. -->
            <xpath expr="//notebook/page[@name='connector']">
                <separator string="Dummy" />
                <field name="channel_dummy_bind_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="backend_id" />
                        <field name="external_id" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
