<odoo>
    <record id="channel_dummy_backend_view_form" model="ir.ui.view">
        <field name="name">channel.dummy.backend.form</field>
        <field name="model">channel.dummy.backend</field>
        <field name="arch" type="xml">
            <form string="Dummy Backend">
                <sheet>
                    <group>
                        <field name="parent_id" />
                        <field name="name" />
                        <field name="pms_property_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="channel_dummy_backend_type_view_form" model="ir.ui.view">
        <field name="name">channel.dummy.backend.type.form</field>
        <field name="model">channel.dummy.backend.type</field>
        <field name="arch" type="xml">
            <form string="Dummy Backend Type">
                <sheet>
                    <group>
                        <field name="parent_id" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
