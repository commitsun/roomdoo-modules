#: model:ir.model.fields,field_description:connector_pms_wubook.field_channel_wubook_pms_room_type__price_base_room_type_id
msgid "Price Derived From"
msgstr "Precio derivado de"

#. module: connector_pms_wubook
#: model:ir.model.fields,field_description:connector_pms_wubook.field_channel_wubook_pms_room_type__price_derivation_rounding
