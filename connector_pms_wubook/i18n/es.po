#. module: connector_pms_wubook
#: model:ir.model.fields,help:connector_pms_wubook.field_channel_wubook_pms_folio__channel_payment_split
msgid ""
"Part of the channel booking held by this folio (part/total) when Wubook "
"split the booking in several folios."
msgstr ""
"Parte de la reserva del canal que contiene esta ficha (parte/total) cuando "
"Wubook dividió la reserva en varias fichas."

#. module: connector_pms_wubook
#: model:ir.model.fields,help:connector_pms_wubook.field_channel_wubook_pms_folio__channel_payment_ids
msgid ""
"Payments registered automatically from what the channel reports as paid "
"online."
msgstr ""
"Pagos registrados automáticamente a partir de lo que el canal comunica como "
"pagado online."

#. module: connector_pms_wubook
#: model_terms:ir.ui.view,arch_db:connector_pms_wubook.channel_wubook_backend_extra_view_search
msgid "Pending"
msgstr "Pendientes"

