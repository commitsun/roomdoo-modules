<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Users in this group can break reconciliations that involve a locked
             period. Grant it to the accountant who has to fix something, and
             remove it afterwards. Note that sudo() does NOT lift the guard:
             group membership is a plain SQL check against the acting user, so
             automated flows running as OdooBot are blocked like anybody else. -->
        <record id="group_bypass_reconcile_lock_date" model="res.groups">
            <field
        name="name"
      >Accounting / Skip reconciliation lock date</field>
        </record>
    </data>
</odoo>
