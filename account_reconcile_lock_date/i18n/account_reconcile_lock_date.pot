#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid ""
"Payment %(payment)s is dated within a closed period (locked up to %(lock)s):"
" its date cannot be changed. Ask accounting."
msgstr ""

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid ""
"The new date %(date)s falls within a closed period (locked up to %(lock)s). "
"Use a later date."
msgstr ""

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid ""
"Date moved from %(old)s to %(new)s in place: the payment settles a document "
"of a closed period, so it was not reset to draft."
msgstr ""

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid ""
"Payment %(payment)s belongs to a closed period and has no single open "
"customer line, so its customer cannot be changed. Ask accounting."
msgstr ""

