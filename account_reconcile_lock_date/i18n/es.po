#. module: account_reconcile_lock_date
#: model_terms:ir.ui.view,arch_db:account_reconcile_lock_date.res_config_settings_view_form
msgid ""
"Block breaking a reconciliation when either matched\n"
"                            entry belongs to a closed period. Reconciling is never\n"
"                            blocked, only undoing it."
msgstr ""
"Impide romper una conciliación cuando alguno de los dos\n"
"                            asientos pertenece a un periodo cerrado. Conciliar\n"
"                            nunca se bloquea, solo deshacerlo."

