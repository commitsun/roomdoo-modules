#. module: account_reconcile_lock_date
#: model_terms:ir.ui.view,arch_db:account_reconcile_lock_date.res_config_settings_view_form
msgid "<span class=\"o_form_label\">Reconciliation lock date</span>"
msgstr "<span class=\"o_form_label\">Fecha de bloqueo de conciliación</span>"

#. module: account_reconcile_lock_date
#: model:res.groups,name:account_reconcile_lock_date.group_bypass_reconcile_lock_date
msgid "Accounting / Skip reconciliation lock date"
msgstr "Contabilidad / Saltar la fecha de bloqueo de conciliación"

#. module: account_reconcile_lock_date
#: model_terms:ir.ui.view,arch_db:account_reconcile_lock_date.res_config_settings_view_form
msgid ""
"Block breaking a reconciliation when either matched\n"
"                            entry belongs to a closed period. Reconciling is never\n"
"                            blocked, only undoing it."
msgstr ""
"Impide romper una conciliación cuando alguno de los dos\n"
"                            asientos pertenece a un periodo cerrado. Conciliar\n"
"                            nunca se bloquea, solo deshacerlo."

#. module: account_reconcile_lock_date
#: model:ir.model,name:account_reconcile_lock_date.model_res_company
msgid "Companies"
msgstr "Compañías"

#. module: account_reconcile_lock_date
#: model:ir.model,name:account_reconcile_lock_date.model_res_config_settings
msgid "Config Settings"
msgstr "Ajustes de configuración"

#. module: account_reconcile_lock_date
#: model:ir.model.fields.selection,name:account_reconcile_lock_date.selection__res_company__reconcile_lock_scope__disabled
msgid "Do not block"
msgstr "No bloquear"

#. module: account_reconcile_lock_date
#: model:ir.model.fields.selection,name:account_reconcile_lock_date.selection__res_company__reconcile_lock_scope__downpayment
msgid "Down payment invoices only"
msgstr "Solo facturas de anticipo"

#. module: account_reconcile_lock_date
#. odoo-python
#: code:addons/account_reconcile_lock_date/models/account_move.py:0
#: code:addons/account_reconcile_lock_date/models/account_partial_reconcile.py:0
#, python-format
msgid "Entries in a locked period:"
msgstr "Asientos en un periodo cerrado:"

#. module: account_reconcile_lock_date
#: model:ir.model.fields.selection,name:account_reconcile_lock_date.selection__res_company__reconcile_lock_scope__all
msgid "Every reconciliation"
msgstr "Todas las conciliaciones"

#. module: account_reconcile_lock_date
#: model:ir.model,name:account_reconcile_lock_date.model_account_move
msgid "Journal Entry"
msgstr "Asiento contable"

#. module: account_reconcile_lock_date
#: model:ir.model,name:account_reconcile_lock_date.model_account_partial_reconcile
msgid "Partial Reconcile"
msgstr "Conciliación parcial"

#. module: account_reconcile_lock_date
#: model:ir.model.fields,field_description:account_reconcile_lock_date.field_res_company__reconcile_lock_scope
#: model:ir.model.fields,field_description:account_reconcile_lock_date.field_res_config_settings__reconcile_lock_scope
msgid "Reconciliation lock scope"
msgstr "Alcance del bloqueo de conciliación"

#. module: account_reconcile_lock_date
#: model:ir.model.fields,help:account_reconcile_lock_date.field_res_company__reconcile_lock_scope
#: model:ir.model.fields,help:account_reconcile_lock_date.field_res_config_settings__reconcile_lock_scope
msgid ""
"Which reconciliations cannot be broken once they involve a locked period. "
"'Do not block' disables the guard; 'Down payment invoices only' guards a "
"reconciliation as soon as either matched entry is a down payment invoice; "
"'Every reconciliation' guards them all. The date used is the company's own "
"accounting lock date."
msgstr ""
"Qué conciliaciones no se pueden romper cuando afectan a un periodo cerrado. "
"'No bloquear' desactiva la guarda; 'Solo facturas de anticipo' la aplica en "
"cuanto alguno de los dos asientos conciliados es una factura de anticipo; "
"'Todas las conciliaciones' la aplica siempre. La fecha utilizada es la propia "
"fecha de bloqueo contable de la compañía."

#. module: account_reconcile_lock_date
#. odoo-python
#: code:addons/account_reconcile_lock_date/models/account_partial_reconcile.py:0
#, python-format
msgid ""
"You cannot break this reconciliation: it matches accounting entries that "
"belong to a closed period."
msgstr ""
"No puede romper esta conciliación: incluye asientos contables que "
"pertenecen a un periodo cerrado."

#. module: account_reconcile_lock_date
#. odoo-python
#: code:addons/account_reconcile_lock_date/models/account_move.py:0
#, python-format
msgid ""
"You cannot reset to draft or cancel this entry: it belongs to a closed "
"period."
msgstr ""
"No puede pasar a borrador ni cancelar este asiento: pertenece a un "
"periodo cerrado."

#. module: account_reconcile_lock_date
#. odoo-python
#: code:addons/account_reconcile_lock_date/models/account_move.py:0
#: code:addons/account_reconcile_lock_date/models/account_partial_reconcile.py:0
#, python-format
msgid "draft entry"
msgstr "asiento en borrador"

#. module: account_reconcile_lock_date
#. odoo-python
#: code:addons/account_reconcile_lock_date/models/account_move.py:0
#: code:addons/account_reconcile_lock_date/models/account_partial_reconcile.py:0
#, python-format
msgid "• %(name)s dated %(date)s (period locked up to %(lock)s)"
msgstr "• %(name)s con fecha %(date)s (periodo cerrado hasta %(lock)s)"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"Rectified with %(refund)s and replaced by %(invoice)s, keeping its "
"payments. The balance was moved with %(entry)s."
msgstr ""
"Rectificada con %(refund)s y sustituida por %(invoice)s, conservando sus "
"cobros. El saldo se ha traspasado con %(entry)s."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"Rectified with %(refund)s and replaced by %(invoice)s, keeping its payments."
msgstr ""
"Rectificada con %(refund)s y sustituida por %(invoice)s, conservando sus "
"cobros."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"The credit note cannot be posted in journal %(journal)s while these older "
"drafts are open: %(drafts)s. Validate or cancel them first."
msgstr ""
"La rectificativa no se puede validar en el diario %(journal)s mientras "
"estén abiertos estos borradores anteriores: %(drafts)s. Valídalos o "
"cancélalos primero."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"%s cannot be partially rectified: it does not have exactly one line with an "
"amount."
msgstr ""
"%s no se puede rectificar parcialmente: no tiene exactamente una línea con "
"importe."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"No journal configured to post the balance transfer entries of company %s."
msgstr ""
"No hay ningún diario configurado para los asientos de traspaso de saldo de "
"la compañía %s."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"%(refund)s or %(invoice)s does not have exactly one customer line, so which "
"balance to move is ambiguous."
msgstr ""
"%(refund)s o %(invoice)s no tiene exactamente una línea de cliente, así que "
"no está claro qué saldo hay que mover."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid "%(refund)s transferred to %(invoice)s"
msgstr "%(refund)s traspasada a %(invoice)s"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"%s already has credit notes issued against it, so rectifying it again would "
"credit part of it twice. Ask accounting to finish the rectification."
msgstr ""
"%s ya tiene rectificativas, así que volver a rectificarla abonaría parte de "
"ella dos veces. Pide a contabilidad que termine la rectificación."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid ""
"%s has more than one customer line, so which balance to move is ambiguous. "
"Ask accounting to rectify it."
msgstr ""
"%s tiene más de una línea de cliente, así que no está claro qué saldo hay "
"que mover. Pide a contabilidad que la rectifique."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid "Rectification of %s"
msgstr "Rectificación de %s"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid ""
"Payment %(payment)s cannot be changed: it settles %(invoices)s, which has "
"already been rectified and replaced by a new invoice that received its "
"money. Changing the payment would make the rectified invoice owe it again. "
"Register the difference as a new payment or refund, or ask accounting."
msgstr ""
"El cobro %(payment)s no se puede modificar: paga %(invoices)s, que ya está "
"rectificada y sustituida por una factura nueva que recibió su dinero. "
"Modificar el cobro haría que la factura rectificada volviera a deberlo. "
"Registra la diferencia como un cobro o una devolución nuevos, o avisa a "
"contabilidad."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_move_rectification.py:0
#, python-format
msgid "%(payment)s transferred to %(invoice)s"
msgstr "%(payment)s traspasado a %(invoice)s"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s belongs to a closed period (locked up to %(lock)s): its journal cannot be changed. Ask accounting to correct it."
msgstr "El cobro %(payment)s es de un periodo cerrado (bloqueado hasta el %(lock)s): no se puede cambiar su diario. Pide a contabilidad que lo corrija."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s belongs to a closed period (locked up to %(lock)s), so it cannot be changed this way. Ask accounting."
msgstr "El cobro %(payment)s es de un periodo cerrado (bloqueado hasta el %(lock)s), así que no se puede cambiar de esta forma. Pregunta a contabilidad."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s belongs to a closed period (locked up to %(lock)s) and settles %(documents)s: its customer cannot be changed, because the customer of a payment follows the invoice it settles."
msgstr "El cobro %(payment)s es de un periodo cerrado (bloqueado hasta el %(lock)s) y salda %(documents)s: no se puede cambiar su cliente, porque el cliente de un cobro es el de la factura que salda."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "%s has already been rectified: its money is already on the invoice that replaced it."
msgstr "%s ya está rectificada: su dinero ya está en la factura que la sustituye."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "%s is a down payment: the final invoice takes it to whichever customer it is issued to."
msgstr "%s es un anticipo: la factura final se lo lleva, sea cual sea el cliente al que se emita."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Change the customer of %s instead: its money moves with it."
msgstr "Cambia en su lugar el cliente de %s: su dinero se mueve con ella."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Ask accounting."
msgstr "Pregunta a contabilidad."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s is dated within a closed period (locked up to %(lock)s): its date cannot be changed. Ask accounting."
msgstr "El cobro %(payment)s tiene fecha de un periodo cerrado (bloqueado hasta el %(lock)s): no se puede cambiar su fecha. Pregunta a contabilidad."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "The new date %(date)s falls within a closed period (locked up to %(lock)s). Use a later date."
msgstr "La nueva fecha %(date)s cae en un periodo cerrado (bloqueado hasta el %(lock)s). Usa una fecha posterior."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Date moved from %(old)s to %(new)s in place: the payment settles a document of a closed period, so it was not reset to draft."
msgstr "Fecha movida del %(old)s al %(new)s sin pasar a borrador: el cobro salda un documento de un periodo cerrado."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s belongs to a closed period and has no single open customer line, so its customer cannot be changed. Ask accounting."
msgstr "El cobro %(payment)s es de un periodo cerrado y no tiene una única línea de cliente abierta, así que no se puede cambiar su cliente. Pregunta a contabilidad."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "%(payment)s transferred to %(partner)s"
msgstr "%(payment)s traspasado a %(partner)s"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "The payment belongs to a closed period, so its customer was not changed: %(entry)s moves its balance to %(partner)s, who has it in their favour until an invoice is reconciled with it."
msgstr "El cobro es de un periodo cerrado, así que no se ha cambiado su cliente: %(entry)s pasa su saldo a %(partner)s, que lo tiene a su favor hasta que se concilie con una factura."

#. module: account_reconcile_lock_date
#: model:ir.model.fields,field_description:account_reconcile_lock_date.field_account_payment__amended_payment_id
msgid "Corrected payment"
msgstr "Cobro corregido"

#. module: account_reconcile_lock_date
#: model:ir.model.fields,field_description:account_reconcile_lock_date.field_account_payment__amendment_ids
msgid "Corrections"
msgstr "Correcciones"

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s is dated within a closed period (locked up to %(lock)s): its amount cannot be changed. Ask accounting to correct it."
msgstr "El cobro %(payment)s tiene fecha de un periodo cerrado (bloqueado hasta el %(lock)s): no se puede cambiar su importe. Pide a contabilidad que lo corrija."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s cannot take an amount of %(amount)s. Register a refund instead."
msgstr "El cobro %(payment)s no puede quedar con un importe de %(amount)s. Registra una devolución."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %s is reconciled with a bank statement: its amount cannot be changed. Ask accounting to correct it."
msgstr "El cobro %s está conciliado con un extracto bancario: no se puede cambiar su importe. Pide a contabilidad que lo corrija."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Payment %(payment)s settles the down payment %(down)s: its amount cannot be changed this way. Ask accounting to correct it."
msgstr "El cobro %(payment)s salda el anticipo %(down)s: su importe no se puede cambiar así. Pide a contabilidad que lo corrija."

#. module: account_reconcile_lock_date
#: code:addons/account_reconcile_lock_date/models/account_payment.py:0
#, python-format
msgid "Amount changed from %(old)s to %(new)s. The payment settles %(documents)s, of a closed period: it was unreconciled and reconciled again with them in the open period."
msgstr "Importe cambiado de %(old)s a %(new)s. El cobro salda %(documents)s, de un periodo cerrado: se ha desconciliado y vuelto a conciliar con ellos en el periodo abierto."

#. module: account_reconcile_lock_date
#: model:ir.model.fields,help:account_reconcile_lock_date.field_account_payment__amended_payment_id
msgid "The payment of a locked period this one corrected. Corrections are no longer registered: a payment of an open period that settles a document of a closed one is changed itself, and one of a closed period is left to accounting. The ones registered before still count in the amount of the payment they correct."
msgstr "El cobro de un periodo cerrado que corrigió este. Ya no se registran correcciones: un cobro de un periodo abierto que salda un documento de uno cerrado se modifica él mismo, y uno de un periodo cerrado lo corrige contabilidad. Las registradas antes siguen contando en el importe del cobro que corrigen."
