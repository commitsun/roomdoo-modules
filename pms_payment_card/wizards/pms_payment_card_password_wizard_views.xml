<odoo>
    <record id="pms_payment_card_password_wizard_form" model="ir.ui.view">
        <field name="name">pms.payment.card.password.wizard.form</field>
        <field name="model">pms.payment.card.password.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="password_configured" invisible="1" />
                <group>
                    <field name="pms_property_id" />
                    <field name="operation" widget="radio" />
                </group>
                <div
          class="alert alert-warning"
          role="alert"
          attrs="{'invisible': [('operation', '!=', 'reset')]}"
        >
                    Resetting the password deletes the cards added in Roomdoo for this
                    property and the card password of its channel managers, which will
                    have to be entered again. The cards the channel manager keeps are
                    not affected.
                </div>
                <group>
                    <field
            name="current_password"
            password="True"
            attrs="{'invisible': [('operation', '!=', 'change')], 'required': [('operation', '=', 'change')]}"
          />
                    <field name="new_password" password="True" required="1" />
                    <field
            name="confirm_password"
            password="True"
            required="1"
          />
                </group>
                <footer>
                    <button
            name="action_apply"
            type="object"
            string="Apply"
            class="btn-primary"
          />
                    <button
            special="cancel"
            string="Cancel"
            class="btn-secondary"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
