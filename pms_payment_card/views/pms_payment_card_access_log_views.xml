<odoo>
    <record id="pms_payment_card_access_log_tree" model="ir.ui.view">
        <field name="name">pms.payment.card.access.log.tree</field>
        <field name="model">pms.payment.card.access.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="timestamp" />
                <field name="user_id" />
                <field name="pms_property_id" />
                <field name="folio_id" />
                <field name="action" />
                <field name="result" />
                <field name="remote_addr" />
            </tree>
        </field>
    </record>
    <record id="pms_payment_card_access_log_search" model="ir.ui.view">
        <field name="name">pms.payment.card.access.log.search</field>
        <field name="model">pms.payment.card.access.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="folio_id" />
                <field name="user_id" />
                <field name="pms_property_id" />
                <filter
          name="failed"
          string="Failed"
          domain="[('result', '!=', 'success')]"
        />
                <group expand="0" string="Group By">
                    <filter
            name="group_user"
            string="User"
            context="{'group_by': 'user_id'}"
          />
                    <filter
            name="group_action"
            string="Action"
            context="{'group_by': 'action'}"
          />
                </group>
            </search>
        </field>
    </record>
    <record
    id="action_pms_payment_card_access_log"
    model="ir.actions.act_window"
  >
        <field name="name">Payment card access log</field>
        <field name="res_model">pms.payment.card.access.log</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem
    id="menu_pms_payment_card_access_log"
    name="Payment card access log"
    action="action_pms_payment_card_access_log"
    parent="pms.pms_configuration_menu"
    groups="base.group_system"
    sequence="200"
  />
</odoo>
