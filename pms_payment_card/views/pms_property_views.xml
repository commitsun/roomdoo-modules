<odoo>
    <record id="pms_property_views_form" model="ir.ui.view">
        <field name="name">pms.property.form.payment.card</field>
        <field name="model">pms.property</field>
        <field name="inherit_id" ref="pms.pms_property_views_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
          string="Payment cards"
          name="payment_cards"
          groups="base.group_system"
        >
                    <group>
                        <field name="payment_card_password_configured" />
                        <field name="payment_card_retention_days" />
                    </group>
                    <button
            name="action_payment_card_password"
            type="object"
            string="Card password"
            class="btn-secondary"
          />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
