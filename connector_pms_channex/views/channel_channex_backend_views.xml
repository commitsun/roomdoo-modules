<odoo>
    <record id="channel_channex_backend_view_form" model="ir.ui.view">
        <field name="name">channel.channex.backend.form</field>
        <field name="model">channel.channex.backend</field>
        <field name="arch" type="xml">
            <form string="Channex Backend">
                <header>
                    <button
            name="action_test_connection"
            type="object"
            string="Test connection"
            class="btn-primary"
          />
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="parent_id" />
                            <field name="name" />
                            <field name="pms_property_id" />
                            <field name="backend_type_id" />
                            <field name="export_disabled" />
                        </group>
                        <group string="Connection">
                            <field name="environment" widget="radio" />
                            <field name="url" />
                            <field name="api_key" password="True" />
                            <field name="page_limit" />
                            <field name="timeout_connect" />
                            <field name="timeout_read" />
                        </group>
                    </group>
                    <group
            string="Channex group"
            help="Every property on Channex belongs to a group. Channex hides its groups screen until the account has a property, so a new account gets its group from here."
          >
                        <field name="group_id" placeholder="UUID of the group" />
                        <field name="group_title" />
                        <div>
                            <button
                name="action_fetch_channex_group"
                type="object"
                string="Fetch group"
                class="btn-secondary"
              />
                            <button
                name="action_create_channex_group"
                type="object"
                string="Create group"
                class="btn-secondary"
                confirm="This creates a new group on Channex. Fetch first to check whether the account already has one."
              />
                        </div>
                    </group>
                    <group
            string="Booking notifications"
            help="Channex calls this address when a booking message is waiting, and what it says is only that: the reading is ours, made with our own key. The address hangs off the web base URL, so Channex can only reach it once that is public."
          >
                        <field name="webhook_url" readonly="1" />
                        <field name="webhook_external_id" />
                        <field name="webhook_secret" password="True" />
                        <div>
                            <button
                name="action_register_channex_webhook"
                type="object"
                string="Send to Channex"
                class="btn-secondary"
                help="Register this address on Channex, or point the one already registered at it."
              />
                        </div>
                    </group>
                    <notebook>
                        <page string="Channels" name="channels">
                            <div
                class="alert alert-warning"
                role="alert"
                attrs="{'invisible': [('unmapped_channel_count', '=', 0)]}"
              >
                                <field
                  name="unmapped_channel_count"
                  class="oe_inline"
                />
                                channel(s) have no agency. Their bookings would come in
                                with nobody to attribute them to.
                            </div>
                            <div class="mb-2">
                                <button
                  name="action_open_channex_channels"
                  type="object"
                  string="Manage channels"
                  class="btn-primary"
                  help="Connect the OTA channels on Channex and say which agency each one is."
                />
                            </div>
                            <field name="channel_ids" nolabel="1" readonly="1" />
                        </page>
                        <page string="Bookings" name="bookings">
                            <div class="mb-2">
                                <button
                  name="action_import_booking_revisions"
                  type="object"
                  string="Import bookings"
                  class="btn-primary"
                  help="Read the messages Channex is holding for this property and queue one job per message. What became of each one shows up below as its job runs."
                />
                            </div>
                            <field
                name="booking_revision_ids"
                nolabel="1"
                readonly="1"
              />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="channel_channex_group_option_view_tree" model="ir.ui.view">
        <field name="name">channel.channex.group.option.tree</field>
        <field name="model">channel.channex.group.option</field>
        <field name="arch" type="xml">
            <tree string="Channex Groups" create="false">
                <field name="title" />
                <field name="external_id" />
                <button
          name="action_use"
          type="object"
          string="Use this group"
          class="btn-primary"
        />
            </tree>
        </field>
    </record>
    <record id="channel_channex_backend_view_tree" model="ir.ui.view">
        <field name="name">channel.channex.backend.tree</field>
        <field name="model">channel.channex.backend</field>
        <field name="arch" type="xml">
            <tree string="Channex Backends">
                <field name="name" />
                <field name="pms_property_id" />
                <field name="environment" />
            </tree>
        </field>
    </record>
</odoo>
