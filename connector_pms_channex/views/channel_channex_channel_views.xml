<odoo>
    <record id="channel_channex_channel_view_tree" model="ir.ui.view">
        <field name="name">channel.channex.channel.tree</field>
        <field name="model">channel.channex.channel</field>
        <field name="arch" type="xml">
            <tree
        string="Channex Channels"
        editable="bottom"
        create="false"
        delete="false"
        decoration-warning="not agency_id"
      >
                <field name="title" readonly="1" />
                <field name="code" readonly="1" />
                <field name="hotel_id" readonly="1" />
                <field name="channex_active" readonly="1" />
                <field
          name="agency_id"
          options="{'no_quick_create': True}"
          placeholder="Pick or create the agency"
        />
                <field name="ota_price_modifier_type" readonly="1" />
                <field
          name="ota_price_modifier_value"
          readonly="1"
          attrs="{'invisible': [('ota_price_modifier_type', '=', False)]}"
        />
                <button
          name="action_push_price_modifier"
          type="object"
          title="Push the rate logic to the Channex mapping"
          class="fa fa-upload"
          attrs="{'invisible': [('agency_id', '=', False)]}"
        />
                <field name="sync_date" optional="hide" readonly="1" />
                <field name="external_id" optional="hide" readonly="1" />
                <field name="active" optional="hide" readonly="1" />
            </tree>
        </field>
    </record>
</odoo>
