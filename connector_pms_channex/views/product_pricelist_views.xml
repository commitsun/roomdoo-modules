<odoo>
    <record id="product_pricelist_view_form" model="ir.ui.view">
        <field name="name">product.pricelist.connector.channex.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="connector_pms.product_pricelist_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='connector']" position="inside">
                <separator string="Channex" />
                <!-- Removing a line stops selling the pricelist through that
                     backend, and takes its rate plans down on Channex. -->
                <field name="channel_channex_bind_ids" nolabel="1">
                    <tree editable="bottom" create="0">
                        <field name="backend_id" readonly="1" />
                    </tree>
                </field>
                <field
          name="channex_rate_plan_ids"
          nolabel="1"
          readonly="1"
          context="{'tree_view_ref': 'connector_pms_channex.channel_channex_rate_plan_view_tree'}"
        />
            </xpath>
        </field>
    </record>
</odoo>
