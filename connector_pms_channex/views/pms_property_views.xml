<odoo>
    <record id="pms_property_view_form" model="ir.ui.view">
        <field name="name">pms.property.connector.channex.form</field>
        <field name="model">pms.property</field>
        <field name="inherit_id" ref="connector_pms.pms_property_views_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='connector']">
                <separator string="Channex" />
                <field name="channel_channex_bind_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="backend_id" />
                        <field name="external_id" />
                        <field name="channex_property_type" />
                        <field name="min_stay_type" />
                        <field name="state_length" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
