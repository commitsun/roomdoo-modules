<odoo noupdate="1">
    <record id="cron_import_booking_revisions" model="ir.cron">
        <field name="name">Channex: sweep booking messages left behind</field>
        <field name="model_id" ref="model_channel_channex_backend" />
        <field name="state">code</field>
        <field name="code">model.channex_cron_import_booking_revisions()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
    </record>
</odoo>
