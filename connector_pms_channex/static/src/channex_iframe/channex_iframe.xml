<templates xml:space="preserve">
    <t t-name="connector_pms_channex.ChannexIframeAction" owl="1">
        <div class="o_action o_channex_iframe_action">
            <!-- The frame is sized by .o_content, which the webclient layout
                 already gives a height: no styling of our own. -->
            <Layout
        display="{ controlPanel: { 'top-right': false, 'bottom-right': false } }"
      >
                <iframe class="h-100 w-100 border-0" t-att-src="url" />
            </Layout>
        </div>
    </t>
</templates>
