<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/comunicacionPV" xmlns:hospe="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/tiposGenerales" xmlns="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/comunicacionPV" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.0.0">
	<xsd:import namespace="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/tiposGenerales" schemaLocation="tiposGenerales.xsd"/>
	<xsd:element name="peticion">
	  <xsd:complexType>
		<xsd:sequence>
			<xsd:element name="solicitud" type="solicitudType"/>
		</xsd:sequence>
	  </xsd:complexType>
	</xsd:element>
	<xsd:complexType name="peticionType" >
		<xsd:sequence>
			<xsd:element name="solicitud" type="solicitudType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="solicitudType">
		<xsd:sequence>
			<xsd:element name="codigoEstablecimiento" type="hospe:codigoEstablecimientoType"/>
			<xsd:element name="comunicacion" type="comunicacionType" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="comunicacionType">
		<xsd:sequence>
			<xsd:element name="contrato" type="hospe:contratoHospedajeType"/>
			<xsd:element name="persona" type="hospe:personaHospedajeType" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
