<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSPY v2004 rel. 3 U (http://www.xmlspy.com) by DINQ / DSIN / INSI / EATE (PEUGEOT CITROEN AUTOMOBILES SA) -->
<xsd:schema targetNamespace="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/tiposGenerales" xmlns="http://www.servicios.ertzaintza.eus/Ertzaintza/ALOJADOS/A19/tiposGenerales" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.0.0">
	<xsd:complexType name="establecimientoType">
		<xsd:choice>
			<xsd:element name="codigo" type="codigoEstablecimientoType"/>
			<xsd:element name="datosEstablecimiento" type="datosEstablecimientoType"/>
		</xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="datosEstablecimientoType">
		<xsd:sequence>
			<xsd:element name="tipo" type="string10Type"/>
			<xsd:element name="nombre" type="string50Type"/>
			<xsd:element name="direccion" type="direccionType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="pagoType">
		<xsd:sequence>
			<xsd:element name="tipoPago" type="string5Type"/>
			<xsd:element name="fechaPago" type="xsd:date" minOccurs="0"/>
			<xsd:element name="medioPago" type="string50Type" minOccurs="0"/>
			<xsd:element name="titular" type="string100Type" minOccurs="0"/>
			<xsd:element name="fechaCaducidadTarjeta" type="xsd:date" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="direccionType">
		<xsd:sequence>
			<xsd:element name="direccion" type="string100Type"/>
			<xsd:element name="direccionComplementaria" type="string100Type" minOccurs="0"/>
			<xsd:element name="codigoMunicipio" type="codigoMunicipioType" minOccurs="0"/>
			<xsd:element name="nombreMunicipio" type="string100Type" minOccurs="0"/>
			<xsd:element name="codigoPostal" type="codigoPostalType"/>
			<xsd:element name="pais" type="ISO3166_3Type"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="contratoHospedajeType">
		<xsd:sequence>
			<xsd:element name="referencia" type="string50Type"/>
			<xsd:element name="fechaContrato" type="xsd:date"/>
			<xsd:element name="fechaEntrada" type="xsd:dateTime"/>
			<xsd:element name="fechaSalida" type="xsd:dateTime"/>
			<xsd:element name="numPersonas" type="xsd:int"/>
			<xsd:element name="numHabitaciones" type="xsd:int" minOccurs="0"/>
			<xsd:element name="internet" type="siNoType" minOccurs="0"/>
			<xsd:element name="pago" type="pagoType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="personaHospedajeType">
		<xsd:sequence>
			<xsd:element name="rol" type="rolPersonaType"/>
			<xsd:element name="nombre" type="string50Type"/>
			<xsd:element name="apellido1" type="string50Type"/>
			<xsd:element name="apellido2" type="string50Type" minOccurs="0"/>
			<xsd:element name="tipoDocumento" type="string5Type" minOccurs="0"/>
			<xsd:element name="numeroDocumento" type="documentoIdentidadType" minOccurs="0"/>
			<xsd:element name="soporteDocumento" type="soporteDocumentoType" minOccurs="0"/>
			<xsd:element name="fechaNacimiento" type="xsd:date"/>
			<xsd:element name="nacionalidad" type="ISO3166_3Type" minOccurs="0"/>
			<xsd:element name="sexo" type="string1Type" minOccurs="0"/>
			<xsd:element name="direccion" type="direccionType"/>
			<xsd:element name="telefono" type="telefonoType" minOccurs="0"/>
			<xsd:element name="telefono2" type="telefonoType" minOccurs="0"/>
			<xsd:element name="correo" type="correoType" minOccurs="0"/>
			<xsd:element name="parentesco" type="string5Type" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="personaReservaType">
		<xsd:sequence>
			<xsd:element name="rol" type="rolPersonaType"/>
			<xsd:element name="nombre" type="string50Type"/>
			<xsd:element name="apellido1" type="string50Type"/>
			<xsd:element name="apellido2" type="string50Type" minOccurs="0"/>
			<xsd:element name="tipoDocumento" type="string5Type" minOccurs="0"/>
			<xsd:element name="numeroDocumento" type="documentoIdentidadType" minOccurs="0"/>
			<xsd:element name="fechaNacimiento" type="xsd:date" minOccurs="0"/>
			<xsd:element name="nacionalidad" type="ISO3166_3Type" minOccurs="0"/>
			<xsd:element name="sexo" type="string1Type" minOccurs="0"/>
			<xsd:element name="direccion" type="direccionType" minOccurs="0"/>
			<xsd:element name="telefono" type="telefonoType" minOccurs="0"/>
			<xsd:element name="telefono2" type="telefonoType" minOccurs="0"/>
			<xsd:element name="correo" type="correoType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="codigoArrendadorType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codigoEstablecimientoType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="documentoIdentidadType">
		<xsd:annotation>
			<xsd:documentation xml:lang="es">
				Número de documento de identidad de la persona.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="15"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="soporteDocumentoType">
		<xsd:annotation>
			<xsd:documentation xml:lang="es">
				Número de soporte del documento de identidad.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="9"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="correoType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="50"/>
			<xsd:pattern value="[^@]+@[^\.]+\..+"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="telefonoType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="20"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codigoMunicipioType">
		<xsd:annotation>
			<xsd:documentation xml:lang="es">
				Código del municipio según el INE. Se compone de cinco dígitos: los dos primeros corresponden al código de la provincia y los tres restantes al del municipio dentro de ésta.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:whiteSpace value="collapse"/>
			<xsd:pattern value="[0-9]{5}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codigoPostalType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="20"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="ISO3166_3Type">
		<xsd:annotation>
			<xsd:documentation xml:lang="es">
				Código del país según la norma ISO 3166-1 Alfa-3.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:whiteSpace value="collapse"/>
			<xsd:pattern value="[a-zA-Z]{3}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="operacionType">
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="A"/>
			<xsd:enumeration value="M"/>
			<xsd:enumeration value="B"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="rolPersonaType">
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="VI"/>
			<xsd:enumeration value="CP"/>
			<xsd:enumeration value="CS"/>
			<xsd:enumeration value="TI"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="siNoType">
		<xsd:annotation>
			<xsd:documentation>Description: Este tipo indica un valor booleano:	'true' = Si and 'false' = No</xsd:documentation>
			<xsd:documentation>Regla: solo 1 (Yes) o 0 (No) son permitidos</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:boolean"/>
	</xsd:simpleType>
	<xsd:simpleType name="idPeticionType">
		<xsd:annotation>
			<xsd:documentation>Identificador de la petición</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="8"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codigoEstadoType">
		<xsd:annotation>
			<xsd:documentation>Códigos de estado devueltos en la cabecera de la petición.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="3"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="codigoErrorType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="3"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="numeroBastidorType">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="17"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string1Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="1"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string5Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="5"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string10Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string25Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="25"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string50Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string100Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="100"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="string200Type">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="200"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
