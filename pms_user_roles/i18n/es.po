#. module: pms_user_roles
#. odoo-python
#: code:addons/pms_user_roles/models/res_users_role_line.py:0
#, python-format
msgid ""
"The permissions of %s are not managed by roles yet and assigning this role "
"would remove some of them. Ask an access rights administrator to migrate the"
" user."
msgstr "Los permisos de %s todavía no se gestionan con roles y asignar este rol le quitaría algunos. Pide a un administrador de permisos que migre al usuario."

#. module: pms_user_roles
#. odoo-python
#: code:addons/pms_user_roles/models/res_users_role.py:0
#, python-format
msgid ""
"The role %(role)s cannot be assignable by profile managers because it grants"
" %(groups)s."
msgstr "El rol %(role)s no puede ser asignable por los gestores de perfiles porque da %(groups)s."

#. module: pms_user_roles
#. odoo-python
#: code:addons/pms_user_roles/models/res_users_role.py:0
#, python-format
msgid ""
"The role %(role)s gives access to all the properties, so it must grant "
"'Multi Companies'."
msgstr "El rol %(role)s da acceso a todas las propiedades, así que debe incluir 'Multi compañías'."

#. module: pms_user_roles
#. odoo-python
#: code:addons/pms_user_roles/models/res_users_role.py:0
#, python-format
msgid ""
"The role %(role)s grants more than one user type (%(types)s). A user can "
"only be of one type."
msgstr "El rol %(role)s da más de un tipo de usuario (%(types)s). Un usuario solo puede ser de un tipo."

