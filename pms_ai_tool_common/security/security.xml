<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_ai_glossary_editor" model="res.groups">
        <field name="name">AI glossary editor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
      name="users"
      eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
    />
        <field
      name="comment"
    >Can create and change the terms of the glossary that the AI tools read. Everybody else can only read them.</field>
    </record>
</odoo>
