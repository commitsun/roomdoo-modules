<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- After the nightly autoinvoicing, so that a folio invoiced in full
         overnight already counts when its earlier invoices are looked at. -->
    <record id="ir_cron_recheck_downpayment_transfers" model="ir.cron">
        <field
      name="name"
    >Down payments: check again the invoices left for review</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">model._cron_recheck_downpayment_transfers()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field
      name="nextcall"
      eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"
    />
    </record>
</odoo>
