<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- No retry_pattern on purpose. The transfer records any failure on the
         invoice itself, except lock and serialization conflicts, which it
         raises as they are so that queue_job's runner retries them, with no
         limit, unlike a RetryableJobError raised inside the job. -->
    <record id="transfer_downpayments_job_function" model="queue.job.function">
        <field
      name="model_id"
      ref="pms_downpayment_lifecycle.model_account_move"
    />
        <field name="method">_transfer_downpayments</field>
        <field
      name="channel_id"
      ref="pms_downpayment_lifecycle.channel_downpayment_transfer"
    />
        <field name="retry_pattern" eval="{}" />
    </record>
    <record
    id="rectify_downpayments_refund_job_function"
    model="queue.job.function"
  >
        <field
      name="model_id"
      ref="pms_downpayment_lifecycle.model_account_payment"
    />
        <field name="method">_rectify_downpayments_for_refund</field>
        <field
      name="channel_id"
      ref="pms_downpayment_lifecycle.channel_downpayment_transfer"
    />
        <field name="retry_pattern" eval="{}" />
    </record>
    <record
    id="rectify_downpayments_cancel_job_function"
    model="queue.job.function"
  >
        <field
      name="model_id"
      ref="pms_downpayment_lifecycle.model_pms_folio"
    />
        <field name="method">_rectify_downpayments_for_cancel</field>
        <field
      name="channel_id"
      ref="pms_downpayment_lifecycle.channel_downpayment_transfer"
    />
        <field name="retry_pattern" eval="{}" />
    </record>
</odoo>
