#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_payment.py:0
#, python-format
msgid "%(amount)s of %(name)s rectified as %(refund)s."
msgstr "%(amount)s de %(name)s rectificados como %(refund)s."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid ""
"%(name)s has nothing actually collected against it, so there is no balance "
"to move."
msgstr ""
"No hay nada realmente cobrado contra %(name)s, así que no hay saldo que "
"traspasar."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid ""
"%(name)s is invoiced to %(partner)s, an identified third party, so it is "
"left for accounting: rectifying VAT charged to a real customer without "
"refunding them is not the same operation as exchanging a simplified invoice."
msgstr ""
"%(name)s está facturada a %(partner)s, un tercero identificado, así que se "
"deja para contabilidad: rectificar un IVA repercutido a un cliente real sin "
"devolvérselo no es la misma operación que canjear una factura simplificada."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid ""
"%(name)s or this invoice does not have exactly one customer line, so which "
"balance to move is ambiguous."
msgstr ""
"%(name)s o esta factura no tienen exactamente una línea de cliente, así que "
"no está claro qué saldo traspasar."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid "%(name)s rectified as %(refund)s and transferred with %(entry)s."
msgstr "%(name)s rectificada como %(refund)s y traspasada con %(entry)s."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid ""
"%(name)s rectified as %(refund)s and transferred with %(entry)s. The final "
"invoice was already settled, so the amount is left open in favour of the "
"customer."
msgstr ""
"%(name)s rectificada como %(refund)s y traspasada con %(entry)s. La factura "
"final ya estaba saldada, así que el importe queda abierto a favor del "
"cliente."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/pms_folio.py:0
#, python-format
msgid "%(name)s rectified as %(refund)s for %(amount)s."
msgstr "%(name)s rectificada como %(refund)s por %(amount)s."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_move.py:0
#, python-format
msgid ""
"%s cannot be partially rectified: it does not have exactly one line with an "
"amount."
msgstr ""
"%s no se puede rectificar parcialmente: no tiene exactamente una línea con "
"importe."

#. module: pms_downpayment_lifecycle
#. odoo-python
#: code:addons/pms_downpayment_lifecycle/models/account_payment.py:0
#, python-format
msgid ""
"%s of this refund does not correspond to any down payment and was left "
"unapplied."
msgstr ""
"%s de esta devolución no corresponde a ningún anticipo y queda sin aplicar."

