#. module: pms_downpayment_lifecycle
#: model_terms:ir.ui.view,arch_db:pms_downpayment_lifecycle.res_config_settings_view_form
msgid ""
"Journal for the entry that moves a down payment from the\n"
"                            customer it was invoiced to onto the customer of the\n"
"                            final invoice."
msgstr "Diario del asiento que traspasa un anticipo del cliente al que se facturó al cliente de la factura final."

#. module: pms_downpayment_lifecycle
#: model:ir.model.fields,help:pms_downpayment_lifecycle.field_res_company__downpayment_transfer_journal_id
#: model:ir.model.fields,help:pms_downpayment_lifecycle.field_res_config_settings__downpayment_transfer_journal_id
msgid ""
"Journal used for the entries that move a balance from one customer onto "
"another: a down payment invoiced to the customer of the final invoice, or an"
" invoice rectified and re-issued without breaking its reconciliations. "
"Without it neither is done automatically."
msgstr "Diario de los asientos que traspasan un saldo de un cliente a otro: un anticipo al cliente de la factura final, o una factura rectificada y emitida de nuevo sin romper sus conciliaciones. Sin él, ninguna de las dos cosas se hace automáticamente."

