#. module: pms_fastapi_reconcile_lock_date
#: code:addons/pms_fastapi_reconcile_lock_date/models/account_move.py:0
#, python-format
msgid ""
"%(invoice)s replaces %(original)s, whose money is held by its credit note, "
"but it is split in several customer lines, so where to put that money is "
"ambiguous. Give it a payment term without instalments."
msgstr ""
"%(invoice)s sustituye a %(original)s, cuyo dinero está en su rectificativa, "
"pero tiene varias líneas de cliente, así que no está claro dónde ponerlo. "
"Ponle un plazo de pago sin vencimientos fraccionados."

#. module: pms_fastapi_reconcile_lock_date
#: code:addons/pms_fastapi_reconcile_lock_date/models/account_move.py:0
#, python-format
msgid ""
"%(invoice)s replaces %(original)s, and the money of that invoice is waiting "
"for it on its credit note. Edit it instead of deleting or cancelling it."
msgstr ""
"%(invoice)s sustituye a %(original)s, y el dinero de esa factura la espera "
"en su rectificativa. Edítala en vez de borrarla o cancelarla."

#. module: pms_fastapi_reconcile_lock_date
#: model:ir.model.fields,field_description:pms_fastapi_reconcile_lock_date.field_account_bank_statement_line__rectification_released_line_ids
#: model:ir.model.fields,field_description:pms_fastapi_reconcile_lock_date.field_account_move__rectification_released_line_ids
#: model:ir.model.fields,field_description:pms_fastapi_reconcile_lock_date.field_account_payment__rectification_released_line_ids
msgid "Payments released by the rectification"
msgstr "Cobros liberados por la rectificación"

#. module: pms_fastapi_reconcile_lock_date
#: model:ir.model.fields,help:pms_fastapi_reconcile_lock_date.field_account_bank_statement_line__rectification_released_line_ids
#: model:ir.model.fields,help:pms_fastapi_reconcile_lock_date.field_account_move__rectification_released_line_ids
#: model:ir.model.fields,help:pms_fastapi_reconcile_lock_date.field_account_payment__rectification_released_line_ids
msgid ""
"Payment lines that settled this invoice until it was rectified the core "
"way. The invoice that replaces it takes them over when it is posted."
msgstr ""
"Apuntes de cobro que saldaban esta factura hasta que se rectificó por la "
"vía estándar. La factura que la sustituye se los queda al validarse."

#. module: pms_fastapi_reconcile_lock_date
#: code:addons/pms_fastapi_reconcile_lock_date/routers/payment.py:0
#, python-format
msgid "Payment %s settles a document of a closed period, so it cannot be cancelled. Register a refund instead."
msgstr "El cobro %s salda un documento de un periodo cerrado, así que no se puede anular. Registra una devolución."

#. module: pms_fastapi_reconcile_lock_date
#: code:addons/pms_fastapi_reconcile_lock_date/routers/payment.py:0
#, python-format
msgid "Payment of a closed period"
msgstr "Cobro de un periodo cerrado"
