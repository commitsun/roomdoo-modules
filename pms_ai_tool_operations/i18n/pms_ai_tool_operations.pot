#, python-format
msgid "%(guests)s guests in %(folios)s folios (%(reservations)s of %(arrivals)s arriving reservations) still have to complete their check-in data between %(date_from)s and %(date_to)s."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_guest_data_pending.py:0
msgid "Arrivals: normal reservations with check-in in the period, in a room for overnight stays, confirmed and not cancelled (also those on board with only some of the guests in). Staff stays, out of service blocks and pre-reservations (not confirmed) are left out."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_guest_data_pending.py:0
msgid "A guest has pending data when the check-in record has no data at all (unknown guest) or lacks some mandatory field (incomplete data): the pre-check-in is not done."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_guest_data_pending.py:0
msgid "Missing: the mandatory fields, such as the identity document, that the incomplete guests of the folio still lack. Holders are shown as first name and initial."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_occupancy_outlook.py:0
#, python-format
msgid "%(overbooked)s property days overbooked and %(high)s more at %(pct)s%% or above between %(date_from)s and %(date_to)s."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_occupancy_outlook.py:0
msgid "Occupied: nights of normal and staff reservations in active rooms for overnight stays. Pre-reservations (not confirmed) and cancelled reservations are not counted."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_occupancy_outlook.py:0
msgid "Blocked: nights of out of service blocks. Available: rooms that are neither occupied nor blocked."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_occupancy_outlook.py:0
msgid "Rooms: active rooms for overnight stays today (the count of past dates uses today's rooms). Occupancy: occupied nights over rooms, as in the Alda KPIs, so blocked rooms are not taken out of the denominator."
msgstr ""

#. module: pms_ai_tool_operations
#. odoo-python
#: code:addons/pms_ai_tool_operations/models/pms_occupancy_outlook.py:0
#, python-format
msgid "Room nights of pre-reservations (not confirmed) in the period are not counted: %s."
msgstr ""

