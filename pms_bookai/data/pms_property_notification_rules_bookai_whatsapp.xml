<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!--
          NOTE: this file used to start with two <delete> elements, meant as a
          one-off cleanup of the layout this matrix replaced. They are gone on
          purpose and must not come back.

          <delete> ignores noupdate="1", so they ran on EVERY module update.

          The first one filtered by template_id.code on the *_v1 codes. That
          "_v1" is the version of the TEMPLATE, not of the rule: the templates
          were never bumped to v2, so the _v2 rules defined below match that
          very domain. Far from having nothing left to clean, the element was
          deleting the rules this file creates, which the <record> blocks then
          recreated on the same update, with an empty pms_property_ids
          (= every property), active, and every other field back to its
          default. Scoping, delays and windows set by an operator were
          therefore reset on each update, re-enabling rules on properties that
          were never meant to receive them and, where another rule already
          covered a property, sending the guest two messages for the same
          event. The sent-count is also kept per rule, and the log's rule_id
          is ondelete="set null", so a recreated rule restarted its
          max_sends_per_record count from zero.

          The second one matched scheduled_timing_mode='window'. None of the
          rules below use that mode, so it never touched them: it only removed
          Window rules created or edited by an operator, and those were NOT
          recreated: they were lost outright.

          If a one-off cleanup is ever needed again, it belongs in a migration
          script, not in a noupdate data file.

          Related, and unchanged by this fix: deleting one of these rules from
          the UI drops its ir_model_data row as well, so the next update
          recreates it, active and for every property. To stop a rule, untick
          Active; never delete it.
        -->

        <!--
          The rules below ship INACTIVE and with an empty pms_property_ids.
          An empty pms_property_ids means EVERY property, so shipping them
          enabled turns a fresh install into guest-facing WhatsApp traffic for
          the whole estate before anyone has chosen which properties should
          send, which template variant they use, or with what delay.

          Onboarding is the right place for that decision: enable each rule
          once it is scoped to the properties that want it. (pms_notifications
          made the same change for its own data rules after an install sent
          real reminder e-mails to real guests overnight.)
        -->

        <!-- 1) booking_confirmation_v1 -->
        <record
      id="pms_property_notification_rule_folio_booking_confirmation_bookai_whatsapp_v2"
      model="pms.property.notification.rule"
    >
            <field name="name">Booking Confirmation (BookAI WhatsApp)</field>
            <field name="active">False</field>
            <field name="pms_property_ids" eval="[(6, 0, [])]" />
            <field
        name="template_id"
        ref="pms_bookai.pms_notification_template_folio_booking_confirmation_whatsapp"
      />
            <field name="target_model_id" ref="pms.model_pms_folio" />
            <field name="rule_type">event</field>
            <field name="event_type">on_write</field>
            <field name="event_pre_domain">[('state', '!=', 'confirm')]</field>
            <field name="event_domain">[('state', '=', 'confirm')]</field>
            <field
        name="on_write_field_ids"
        eval="[(6, 0, [ref('pms.field_pms_folio__state')])]"
      />
            <field name="channel">bookai_whatsapp</field>
            <field name="send_immediately">True</field>
            <field name="max_sends_per_record">1</field>
        </record>

        <!-- 2) booking_modification_v1 -->
        <record
      id="pms_property_notification_rule_folio_booking_modification_bookai_whatsapp"
