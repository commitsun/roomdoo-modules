<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_room_view_form" model="ir.ui.view">
        <field name="name">pms.room.form.kellys_daily_report</field>
        <field name="model">pms.room</field>
        <field name="inherit_id" ref="pms.pms_room_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='sequence']" position="after">
                <field name="cleaning_sequence" />
            </xpath>
        </field>
    </record>
    <record id="pms_room_view_tree" model="ir.ui.view">
        <field name="name">pms.room.tree.kellys_daily_report</field>
        <field name="model">pms.room</field>
        <field name="inherit_id" ref="pms.pms_room_view_tree" />
        <field name="arch" type="xml">
            <field name="short_name" position="after">
                <field name="cleaning_sequence" optional="show" />
            </field>
        </field>
    </record>
</odoo>
