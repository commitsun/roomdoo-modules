<odoo>
    <record
    id="channel_wubook_backend_card_password_wizard_form"
    model="ir.ui.view"
  >
        <field
      name="name"
    >channel.wubook.backend.card.password.wizard.form</field>
        <field name="model">channel.wubook.backend.card.password.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    The password Wubook asks for to show the cards of the bookings. It
                    is kept sealed: only a user who types the card password of the
                    property can use it.
                </p>
                <group>
                    <field name="backend_id" />
                    <field name="password" password="True" required="1" />
                    <field
            name="confirm_password"
            password="True"
            required="1"
          />
                </group>
                <footer>
                    <button
            name="action_apply"
            type="object"
            string="Save"
            class="btn-primary"
          />
                    <button
            special="cancel"
            string="Cancel"
            class="btn-secondary"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
