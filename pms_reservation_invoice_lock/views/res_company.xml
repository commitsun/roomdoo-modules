<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="company_view_form" model="ir.ui.view">
        <field name="name">res.company.form.reservation.invoice.lock</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="reservation_invoice_block_policy" widget="radio" />
                <field
          name="reservation_invoice_block_domain"
          widget="domain"
          options="{'model': 'pms.reservation'}"
          attrs="{'invisible': [('reservation_invoice_block_policy', '!=', 'other')]}"
        />
                <field
          name="reservation_invoice_block_message"
          placeholder="Ex.: Invoices cannot be validated before the guest checks out."
        />
            </xpath>
        </field>
    </record>
</odoo>
